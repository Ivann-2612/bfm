# English lives at "/" (built as /en/), Serbian at /sr/.

Options -MultiViews
RewriteEngine On

# Force https and drop www.

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://belgrademagicfestival.rs%{REQUEST_URI} [R=301,L]

# Old /en/... addresses → prefix-less.

RewriteCond %{THE_REQUEST} \s/en(/|\s|\?)
RewriteRule ^en/?(.\*)$ /$1 [R=301,L]

# "/" and "/privacy/" show the English pages.

RewriteRule ^$ en/ [L]
RewriteRule ^privacy/?$ en/privacy/ [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|svg|mp3)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=300"
</FilesMatch>
</IfModule>
